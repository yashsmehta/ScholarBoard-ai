# ScholarBoard NL-search API settings (read by systemd).
# Gemini API key used by the headless Antigravity CLI (agy). Keep this file 640 root:scholarboard.
GEMINI_API_KEY=
NL_SEARCH_AGY_MODEL=gemini-3.8-flash-medium
# Engines available; the server picks per search (users don't choose): Claude Code
# while fewer than NL_SEARCH_CLAUDE_SLOTS Claude runs are active, else Antigravity.
# Add claude once the scholarboard user is signed in to a Claude subscription
# (see README):  NL_SEARCH_ENGINES=agy,claude
NL_SEARCH_ENGINES=agy
NL_SEARCH_CLAUDE_SLOTS=3
NL_SEARCH_CONCURRENCY=10
NL_SEARCH_MAX_QUEUE=20
NL_SEARCH_IP_LIMIT=6
NL_SEARCH_DAILY_LIMIT=300
NL_SEARCH_ALLOWED_ORIGINS=https://yashsmehta.com,https://www.yashsmehta.com
